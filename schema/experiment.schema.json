{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OakLab experiment",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "title",
    "author",
    "oak",
    "liquid",
    "extraction",
    "observations",
    "replication",
    "evidence",
    "tastingSessions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^(OL|LOCAL)-[A-Za-z0-9-]+$"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "oak": {
      "type": "object",
      "required": [
        "type",
        "species",
        "origin",
        "form",
        "particleSize",
        "toast",
        "preparation"
      ]
    },
    "liquid": {
      "type": "object",
      "required": [
        "base",
        "abv",
        "volumeMl"
      ]
    },
    "extraction": {
      "type": "object",
      "required": [
        "doseGPerL",
        "durationDays",
        "temperatureC",
        "container",
        "agitation",
        "notes"
      ]
    },
    "observations": {
      "type": "object",
      "required": [
        "appearance",
        "aroma",
        "taste",
        "mouthfeel",
        "overallNotes"
      ]
    },
    "replication": {
      "type": "object",
      "required": [
        "sourceId"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "photos",
        "attachments",
        "sourceNotes"
      ]
    },
    "tastingSessions": {
      "type": "array",
      "description": "One or more sensory evaluation sessions. Scores use the OakLab 10-criterion 1–5 system; overall impression is separate 1–10 and excluded from total.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "scores",
          "total",
          "overall"
        ],
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "agingDays": {
            "type": [
              "number",
              "null"
            ]
          },
          "order": {
            "type": [
              "integer",
              "null"
            ]
          },
          "scores": {
            "type": "object",
            "required": [
              "aroma",
              "softness",
              "oak",
              "vanilla",
              "caramelToast",
              "fruitNut",
              "smokeChar",
              "spirit",
              "bitterness",
              "astringency"
            ],
            "properties": {
              "aroma": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "softness": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "oak": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "vanilla": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "caramelToast": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "fruitNut": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "smokeChar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "spirit": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "bitterness": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "astringency": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              }
            },
            "additionalProperties": false
          },
          "total": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 50
          },
          "overall": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "legacyCombinedBitternessTannin": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          }
        },
        "additionalProperties": false
      }
    }
  }
}
